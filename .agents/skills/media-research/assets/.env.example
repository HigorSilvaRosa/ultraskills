# ==============================================================================
# Media Research Skill - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' in the root directory and fill in your API keys:
# cp .env.example .env

# --- Unsplash API (Images) ---
# Gold standard for high-quality, free-to-use photography (50 requests/hour free tier).
# Sign up and get your Access Key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- Pexels API (Images and Videos) ---
# Free API for high quality stock photos and videos (200 requests/hour free tier).
# Sign up and get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Pixabay API (Images and Videos) ---
# Vast library of photos, illustrations, vectors, and videos.
# Sign up and get your key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Freesound API (Audio / Sound Effects / Samples) ---
# Collaborative database of Creative Commons licensed sounds.
# Sign up and get your key at: https://freesound.org/docs/api/
FREESOUND_API_KEY=
